        "NSLocalNetworkUsageDescription": {
            "comment": "Privacy - Local Network Usage Description",
            "extractionState": "manual",
            "localizations": {
                "ar": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "يستخدم Roam شبكتك المحلية للعثور على أجهزة Roku المتصلة بشبكة Wi-Fi وإرسال أوامر التحكم عن بُعد إليها، مثل العثور على تلفزيون Roku في غرفة المعيشة لتتمكن من تغيير القناة أو ضبط مستوى الصوت أو تشغيل تطبيق مثل Netflix من جهاز iPhone الخاص بك."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam nutzt Ihr lokales Netzwerk, um Roku-Geräte in Ihrem WLAN zu finden und ihnen Fernbedienungsbefehle zu senden, zum Beispiel um Ihren Roku TV im Wohnzimmer zu entdecken, damit Sie vom iPhone aus den Kanal wechseln, die Lautstärke anpassen oder eine App wie Netflix starten können."
                    }
                },
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam uses your local network to find Roku devices on your Wi-Fi and send them remote-control commands, for example discovering your living room Roku TV so you can change the channel, adjust the volume, or launch an app like Netflix from your iPhone."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam usa tu red local para encontrar dispositivos Roku en tu wifi y enviarles comandos del mando a distancia, por ejemplo para detectar el Roku TV del salón y poder cambiar de canal, ajustar el volumen o abrir una app como Netflix desde tu iPhone."
                    }
                },
                "es-419": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam usa tu red local para encontrar dispositivos Roku en tu wifi y enviarles comandos del control remoto, por ejemplo para detectar el Roku TV de la sala y poder cambiar de canal, ajustar el volumen o abrir una app como Netflix desde tu iPhone."
                    }
                },
                "fil": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ginagamit ng Roam ang iyong lokal na network para hanapin ang mga Roku device sa iyong Wi-Fi at magpadala sa kanila ng mga utos ng remote control, halimbawa para matuklasan ang Roku TV sa iyong sala nang sa gayon ay mapalitan mo ang channel, ma-adjust ang volume, o mabuksan ang app tulad ng Netflix mula sa iyong iPhone."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam utilise votre réseau local pour trouver les appareils Roku sur votre Wi-Fi et leur envoyer des commandes de télécommande, par exemple pour détecter le téléviseur Roku de votre salon afin de changer de chaîne, régler le volume ou lancer une application comme Netflix depuis votre iPhone."
                    }
                },
                "fr-CA": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam utilise votre réseau local pour trouver les appareils Roku sur votre Wi-Fi et leur envoyer des commandes de télécommande, par exemple pour détecter le téléviseur Roku de votre salon afin de changer de chaîne, régler le volume ou lancer une application comme Netflix depuis votre iPhone."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam usa la rete locale per trovare i dispositivi Roku sul tuo Wi-Fi e inviare loro comandi del telecomando, ad esempio per rilevare il Roku TV del soggiorno e poter cambiare canale, regolare il volume o aprire un'app come Netflix dall'iPhone."
                    }
                },
                "pa": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "ਰੋਮ ਤੁਹਾਡੇ ਵਾਈ-ਫਾਈ ਉੱਤੇ Roku ਡੀਵਾਈਸ ਲੱਭਣ ਅਤੇ ਉਹਨਾਂ ਨੂੰ ਰਿਮੋਟ ਕੰਟਰੋਲ ਕਮਾਂਡਾਂ ਭੇਜਣ ਲਈ ਤੁਹਾਡੇ ਸਥਾਨਕ ਨੈੱਟਵਰਕ ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ, ਜਿਵੇਂ ਕਿ ਤੁਹਾਡੇ ਲਿਵਿੰਗ ਰੂਮ ਦਾ Roku TV ਲੱਭਣਾ ਤਾਂ ਜੋ ਤੁਸੀਂ ਆਪਣੇ iPhone ਤੋਂ ਚੈਨਲ ਬਦਲ ਸਕੋ, ਆਵਾਜ਼ ਘਟਾ-ਵਧਾ ਸਕੋ, ਜਾਂ Netflix ਵਰਗੀ ਐਪ ਖੋਲ੍ਹ ਸਕੋ।"
                    }
                },
                "pt-BR": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O Roam usa a sua rede local para encontrar dispositivos Roku no seu Wi-Fi e enviar comandos de controle remoto para eles, por exemplo para localizar a Roku TV da sala e você poder mudar de canal, ajustar o volume ou abrir um app como a Netflix pelo iPhone."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O Roam usa a sua rede local para encontrar dispositivos Roku na sua rede Wi-Fi e enviar-lhes comandos de telecomando, por exemplo para localizar a Roku TV da sala e poder mudar de canal, ajustar o volume ou abrir uma app como a Netflix a partir do iPhone."
                    }
                },
                "vi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam sử dụng mạng cục bộ của bạn để tìm các thiết bị Roku trên Wi-Fi và gửi lệnh điều khiển từ xa đến chúng, ví dụ như tìm Roku TV trong phòng khách để bạn có thể đổi kênh, chỉnh âm lượng hoặc mở ứng dụng như Netflix từ iPhone."
                    }
                },
                "zh-Hans": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam 使用本地网络在您的 Wi-Fi 上查找 Roku 设备并向其发送遥控指令，例如找到客厅的 Roku TV，以便您通过 iPhone 换台、调节音量或打开 Netflix 等应用。"
                    }
                }
            }
        },
        "NSPhotoLibraryAddUsageDescription": {
            "comment": "Privacy - Photo Library Additions Usage Description",
            "extractionState": "manual",
            "localizations": {
                "ar": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "يضيف Roam صورة إلى مكتبة الصور لديك فقط عندما تضغط على «حفظ في الصور» لمرفق داخل محادثة الدعم مع المطوّر، مثل حفظ لقطة شاشة أرسلها إليك المطوّر أثناء مساعدتك في حل مشكلة في إعداد جهاز Roku."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam fügt Ihrer Fotomediathek nur dann ein Bild hinzu, wenn Sie bei einem Anhang in Ihrer Support-Unterhaltung mit dem Entwickler auf „In Fotos sichern“ tippen, zum Beispiel um einen Screenshot zu sichern, den Ihnen der Entwickler bei der Fehlersuche an Ihrem Roku geschickt hat."
                    }
                },
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam adds an image to your photo library only when you tap Save to photos on an attachment in your support conversation with the developer, for example saving a screenshot the developer sent you while helping troubleshoot your Roku setup."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam añade una imagen a tu fototeca solo cuando pulsas «Guardar en Fotos» en un archivo adjunto de tu conversación de soporte con el desarrollador, por ejemplo para guardar una captura de pantalla que el desarrollador te envió mientras te ayudaba a resolver un problema con tu Roku."
                    }
                },
                "es-419": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam agrega una imagen a tu galería de fotos solo cuando tocas «Guardar en Fotos» en un archivo adjunto de tu conversación de soporte con el desarrollador, por ejemplo para guardar una captura de pantalla que el desarrollador te envió mientras te ayudaba a resolver un problema con tu Roku."
                    }
                },
                "fil": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nagdaragdag lang ang Roam ng larawan sa iyong photo library kapag na-tap mo ang Save to photos sa isang attachment sa iyong support conversation kasama ang developer, halimbawa kapag sini-save ang screenshot na ipinadala ng developer habang tinutulungan kang ayusin ang setup ng iyong Roku."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam n'ajoute une image à votre photothèque que lorsque vous touchez « Enregistrer dans Photos » sur une pièce jointe de votre conversation d'assistance avec le développeur, par exemple pour enregistrer une capture d'écran que le développeur vous a envoyée en vous aidant à configurer votre Roku."
                    }
                },
                "fr-CA": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam n'ajoute une image à votre photothèque que lorsque vous touchez « Enregistrer dans Photos » sur une pièce jointe de votre conversation d'assistance avec le développeur, par exemple pour enregistrer une capture d'écran que le développeur vous a envoyée en vous aidant à configurer votre Roku."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam aggiunge un'immagine alla tua libreria foto solo quando tocchi «Salva in Foto» su un allegato della tua conversazione di assistenza con lo sviluppatore, ad esempio per salvare uno screenshot che lo sviluppatore ti ha inviato mentre ti aiutava a risolvere un problema con il tuo Roku."
                    }
                },
                "pa": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "ਰੋਮ ਤੁਹਾਡੀ ਫੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਤਸਵੀਰ ਸਿਰਫ਼ ਉਦੋਂ ਜੋੜਦਾ ਹੈ ਜਦੋਂ ਤੁਸੀਂ ਡਿਵੈਲਪਰ ਨਾਲ ਆਪਣੀ ਸਹਾਇਤਾ ਗੱਲਬਾਤ ਵਿੱਚ ਕਿਸੇ ਅਟੈਚਮੈਂਟ ਉੱਤੇ «ਫੋਟੋਆਂ ਵਿੱਚ ਸੇਵ ਕਰੋ» ਦਬਾਉਂਦੇ ਹੋ, ਜਿਵੇਂ ਕਿ ਉਹ ਸਕ੍ਰੀਨਸ਼ਾਟ ਸੇਵ ਕਰਨਾ ਜੋ ਡਿਵੈਲਪਰ ਨੇ ਤੁਹਾਡੇ Roku ਦੀ ਸੈੱਟਅੱਪ ਸਮੱਸਿਆ ਹੱਲ ਕਰਨ ਵਿੱਚ ਮਦਦ ਕਰਦੇ ਹੋਏ ਭੇਜਿਆ ਸੀ।"
                    }
                },
                "pt-BR": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O Roam adiciona uma imagem à sua fototeca somente quando você toca em «Salvar em Fotos» em um anexo da sua conversa de suporte com o desenvolvedor, por exemplo para salvar uma captura de tela que o desenvolvedor enviou enquanto ajudava a resolver um problema na configuração do seu Roku."
                    }
                },
                "pt-PT": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "O Roam adiciona uma imagem à sua fototeca apenas quando toca em «Guardar em Fotos» num anexo da sua conversa de apoio com o programador, por exemplo para guardar uma captura de ecrã que o programador lhe enviou enquanto o ajudava a resolver um problema na configuração do seu Roku."
                    }
                },
                "vi": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Roam chỉ thêm ảnh vào thư viện ảnh của bạn khi bạn chạm vào «Lưu vào Ảnh» trên một tệp đính kèm trong cuộc trò chuyện hỗ trợ với nhà phát triển, ví dụ như lưu ảnh chụp màn hình mà nhà phát triển đã gửi khi giúp bạn khắc phục sự cố thiết lập Roku."
                    }
                },
                "zh-Hans": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "只有当您在与开发者的支持对话中点按附件上的「存储到照片」时，Roam 才会将该图片添加到您的照片图库，例如保存开发者在帮您排查 Roku 设置问题时发送的截图。"
                    }
                }
            }
        }
    },
    "version": "1.0"
}

# Copy to /etc/roam-symbolicator/env and fill in real values.
# This file holds only the env vars the worker actually consumes; the rest of
# the RoamCli args have safe defaults for worker mode.

# Activate worker mode (equivalent to running with --symbolicate).
SYMBOLICATE=true

# Where the worker stores its dSYM cache + downloaded dyld_shared_cache files.
#
# One dyld_shared_cache is kept per device-model/OS-build pair and each runs
# 5-6 GB. They cannot be shared between models: Apple builds the cache per
# device family, so two models on the same build and arch have genuinely
# different files. A fleet spread across models and builds therefore grows this
# directory quickly — it reached 149 GB before eviction existed.
DATA_DIR=/var/lib/roam-symbolicator/data

# Cap on the downloaded system dyld_shared_cache tree, in bytes. Once a fresh
# download pushes it past the cap, whole <device>/<build> caches are dropped
# least-recently-used-first until it fits. Defaults to 256 GiB.
# Provision disk for this plus ~10 GB of headroom.
#SYMBOLICATE_CACHE_MAX_BYTES=274877906944

# Public backend the worker leases payloads from.
BACKEND_URL=https://backend.roam.msd3.io
BACKEND_API_KEY=replace-me

# Tuning knobs. Batch size is how many payloads symbolicate concurrently, not
# how many caches download concurrently: downloads are capped at 2 in the worker
# and deduplicated per device/build, because five 5 GB pulls over one link just
# means five slow ones instead of one fast one.
SYMBOLICATE_BATCH_SIZE=5
SYMBOLICATE_IDLE_SECONDS=600

# Logs.
RUST_LOG=info,roam_backend=info

# GitHub token for appledb lookups. Set this — appledb resolves builds through
# the GitHub API, and unauthenticated that is 60 requests/hour per IP, which a
# single build lookup can spend in one go: production ran without a token and
# every appledb attempt came back 403. A token raises the limit to 5000/hour.
# Needs no scopes; a bare public-read token is enough. GITHUB_TOKEN also works.
#
# appledb is the fallback, not the primary: ipsw.me is tried first for every
# platform, macOS included (it served iMac21,1 on 25F80 in production, contrary
# to the belief that it indexes iOS only). appledb earns its place by carrying
# very new builds before ipsw.me indexes them.
#IPSW_GITHUB_TOKEN=replace-me

# `ipsw` must be on the PATH for system-symbol downloads. Install via:
#   curl -L https://github.com/blacktop/ipsw/releases/download/<ver>/ipsw_<ver>_<os>_<arch>.tar.gz | tar -xz -C /usr/local/bin ipsw

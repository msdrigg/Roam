{
  "db_name": "SQLite",
  "query": "\n            SELECT thread_id,\n                latest_crash_message_id,\n                latest_crash_at_ms,\n                app_version,\n                installed_version,\n                device_type,\n                os_version,\n                exception_type,\n                signal,\n                termination_code,\n                reviewed_at_ms,\n                reviewed_by,\n                reviewed_message_id,\n                matched_rule_id,\n                review_note\n            FROM crash_reviews\n            WHERE (?1 = 0 OR reviewed_at_ms IS NULL OR reviewed_at_ms < latest_crash_at_ms)\n              AND (?2 IS NULL OR app_version = ?2)\n              AND (?3 IS NULL OR latest_crash_at_ms < ?3)\n            ORDER BY latest_crash_at_ms DESC\n            LIMIT ?4\n            ",
